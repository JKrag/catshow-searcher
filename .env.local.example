# Vercel Blob token — read+write access to the catz-data.json blob.
# Without this, the app reads/writes .data/catz.json locally.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Bearer token for the admin status API (/api/debug).
# Required in production; not required in local dev.
# CATZ_ADMIN_TOKEN=

# OSRM routing base URL.
# Default: https://router.project-osrm.org (public demo, not for production).
# CATZ_OSRM_BASE=https://router.project-osrm.org

# User-Agent string sent to external APIs (Nominatim, fifeweb.org, shows.tica.org).
# CATZ_USER_AGENT=catz/1.0
